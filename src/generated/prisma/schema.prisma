// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  username      String         @unique
  artistProfile ArtistProfile?
  subscription  Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ArtistProfile {
  id           Int            @id @default(autoincrement())
  user         User           @relation(fields: [userId], references: [id])
  userId       Int            @unique
  bio          String
  displayName  String
  gender       Gender
  avtarUrl     String
  bannerUrl    String
  Audios       Audios[]
  subscription Subscription[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum Gender {
  MALE
  FEMALE
  TRANSGENDER
  NON_BINARY
}

model Audios {
  id          Int           @id @default(autoincrement())
  artistId    Int
  artist      ArtistProfile @relation(fields: [artistId], references: [id])
  audioUrl    String
  title       String
  desc        String
  duration    Int
  voiceData   VoiceMeta     @relation(fields: [voicedataId], references: [id])
  voicedataId Int           @unique
  createdAt   DateTime      @default(now())
  public      Boolean       @default(true)
}

model VoiceMeta {
  id             Int     @id @default(autoincrement())
  domVoice       Gender
  femaleCount    Int     @default(0)
  maleCount      Int     @default(0)
  nonBinaryCount Int     @default(0)
  transCount     Int     @default(0)
  Audio          Audios?
}

model Subscription {
  id       Int           @id @default(autoincrement())
  userId   Int
  artistId Int
  user     User          @relation(fields: [userId], references: [id])
  artist   ArtistProfile @relation(fields: [artistId], references: [id])
  paidday  DateTime      @default(now())

  @@unique([userId, artistId])
}
